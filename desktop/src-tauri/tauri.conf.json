{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucidfish",
  "version": "0.5.2",
  "identifier": "com.lucidfish.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lucidfish",
        "width": 1380,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Explainable chess coaching",
    "longDescription": "Stockfish tells you the best move; Lucidfish tells you why. Analyse your games, understand the reasons behind every mistake, train on them and learn the concepts.",
    "copyright": "Lucidfish contributors. Bundles Stockfish (GPLv3).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/lucidfish-server"
    ],
    "resources": {
      "resources/engine/": "engine/",
      "../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQ0QzN0ZGRTUyMzA2RDgKUldUWUJpUGwvemZOYzVHNjdzKytCMGc4a08zQ1l1clZUdFlCblZSUW5iN1AxNlplSnZucC9KS1MK",
      "endpoints": [
        "https://github.com/s4mstruthers/Lucidfish/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
