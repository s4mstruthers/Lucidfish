{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Lucidfish window: the loader page and, once the backend is up, the app served from it on localhost.",
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "updater:default",
    "process:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
