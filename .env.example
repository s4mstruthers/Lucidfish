# Copy this file to ".env" (same folder) and fill in what you need.
# .env is ignored by git, so your keys never end up in a commit.
# Environment variables always win over this file; settings saved in the web
# app win over the defaults below.

# ---- Cloud AI providers (only the ones you use) -----------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# LUCIDFISH_CUSTOM_API_KEY=...        # for a custom OpenAI-compatible server, if it needs one

# ---- Defaults (the web app's Settings panel can change these too) -----------
# LUCIDFISH_PROVIDER=ollama           # ollama | openai | anthropic | gemini | openrouter | groq | custom
# LUCIDFISH_MODEL=llama3.1:8b
# LUCIDFISH_BASE_URL=                 # server URL for ollama/custom providers
# OLLAMA_HOST=http://localhost:11434
# LUCIDFISH_DETAIL=standard           # key | standard | full
# LUCIDFISH_NUM_CTX=8192              # context window for local models

# ---- Engine -----------------------------------------------------------------
# LUCIDFISH_STOCKFISH=/path/to/stockfish      # Windows: C:\path\to\stockfish.exe
# LUCIDFISH_DEPTH=18
# LUCIDFISH_THREADS=6
# LUCIDFISH_HASH_MB=256

# ---- Misc -------------------------------------------------------------------
# LUCIDFISH_DATA_DIR=                 # where the database lives (default: per-user app-data folder)
# LUCIDFISH_PORT=8420
# LUCIDFISH_CHESSCOM_USER=            # default account for `lucidfish` with no arguments
# LUCIDFISH_LICHESS_USER=
# LICHESS_TOKEN=                      # only if the Lichess opening explorer asks for authentication
